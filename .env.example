# Copy to .env and change the values. .env is git-ignored.

# PostgreSQL
POSTGRES_DB=mortgage_tracker
POSTGRES_USER=mortgage
POSTGRES_PASSWORD=change-me
# Host port for connecting a DB client (bound to 127.0.0.1 only)
POSTGRES_PORT=5433

# App login (single user)
APP_USERNAME=admin
APP_PASSWORD=change-me-too

# Host ports
APP_PORT=3000
BACKEND_PORT=8080
